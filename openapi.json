    "components": {
        "schemas": {
            "ChatStreamRequest": {
                "properties": {
                    "session_id": {
                        "type": "string",
                        "title": "Session Id"
                    },
                    "message": {
                        "type": "string",
                        "title": "Message"
                    },
                    "image_url": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Image Url"
                    }
                },
                "type": "object",
                "required": [
                    "session_id",
                    "message"
                ],
                "title": "ChatStreamRequest"
            },
            "ClaimSessionRequest": {
                "properties": {
                    "anon_id": {
                        "type": "string",
                        "title": "Anon Id"
                    }
                },
                "type": "object",
                "required": [
                    "anon_id"
                ],
                "title": "ClaimSessionRequest"
            },
            "CreateSessionRequest": {
                "properties": {
                    "anon_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Anon Id"
                    },
                    "layer": {
                        "type": "string",
                        "pattern": "^(external|internal)$",
                        "title": "Layer"
                    },
                    "process_type": {
                        "type": "string",
                        "title": "Process Type"
                    }
                },
                "type": "object",
                "required": [
                    "layer",
                    "process_type"
                ],
                "title": "CreateSessionRequest"
            },
            "CreateSessionResponse": {
                "properties": {
                    "session_id": {
                        "type": "string",
                        "title": "Session Id"
                    }
                },
                "type": "object",
                "required": [
                    "session_id"
                ],
                "title": "CreateSessionResponse"
            },
            "CreateTicketRequest": {
                "properties": {
                    "session_id": {
                        "type": "string",
                        "title": "Session Id"
                    },
                    "issue_summary": {
                        "type": "string",
                        "title": "Issue Summary"
                    },
                    "process_type": {
                        "type": "string",
                        "title": "Process Type"
                    }
                },
                "type": "object",
                "required": [
                    "session_id",
                    "issue_summary",
                    "process_type"
                ],
                "title": "CreateTicketRequest"
            },
            "CreateTicketResponse": {
                "properties": {
                    "ticket_id": {
                        "type": "string",
                        "title": "Ticket Id"
                    }
                },
                "type": "object",
                "required": [
                    "ticket_id"
                ],
                "title": "CreateTicketResponse"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LoginRequest": {
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "title": "Email"
                    },
                    "password": {
                        "type": "string",
                        "title": "Password"
                    }
                },
                "type": "object",
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "LoginResponse": {
                "properties": {
                    "access_token": {
                        "type": "string",
                        "title": "Access Token"
                    },
                    "provider": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Provider"
                    }
                },
                "type": "object",
                "required": [
                    "access_token",
                    "provider"
                ],
                "title": "LoginResponse"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        },
        "securitySchemes": {
            "HTTPBearer": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}